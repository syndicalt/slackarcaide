# Agent Arcade backend environment (copy to .env or export)
# Postgres: postgresql+asyncpg://<user>:<pass>@<host>:5432/<db>
ARCADE_DATABASE_URL=postgresql+asyncpg://arcade:arcade@localhost:5432/arcade
ARCADE_DATABASE_POOL_SIZE=10
ARCADE_DATABASE_MAX_OVERFLOW=20
# Redis
ARCADE_REDIS_URL=redis://localhost:6379/0
ARCADE_REDIS_MAX_CONNECTIONS=500
# Comma-separated allowed CORS origins, or * for all
ARCADE_CORS_ORIGINS=*
ARCADE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend,api.slackarcaide.com
ARCADE_PUBLIC_BASE_URL=http://localhost:8000
ARCADE_METRICS_BEARER_TOKEN=
# Comma-separated Cloudflare edge CIDRs. When set, a request's X-Real-IP must
# belong to one of these networks before CF-Connecting-IP is trusted.
ARCADE_TRUSTED_EDGE_PROXY_CIDRS=
